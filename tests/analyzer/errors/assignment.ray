struct Foo {
    fn f(self, a: int) { print a }
}

fn add(a: int) {
    // Can't assign to function parameter
    a = 4
}

fn main() {
    add = 1
    add(5) = 1

    var noval: int
    noval = 1.4

    let cte = 5
    cte = 7

    // Assign to method
    var foo = Foo {}

    fn f2(this: Foo, a: int) {
        print 2 * a
    }

    foo.f = f2
}

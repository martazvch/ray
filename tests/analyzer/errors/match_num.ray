fn getValue() -> int { return 5 }

fn main() {
    value := 2

    _ = match value {
        0 => 10
        2 => 30
        2 => 3
    }

    _ = match value {
        0 => 10
        1 => 20
        4 => 30
        2..6 => 40
        else => 50
    }

    _ = match value {
        0 => 10
        1 => 20
    }
    
    _ = match value {
        getValue() => 10
        1 => 20
    }

    _ = match value {
        -5 => -10
        -8..-2 => 20
        else => 100
    }

    _ = match value {
        -8..-2 => 20
        -5 => -10
        else => 100
    }

    match value {
        5..2 => {}
    }

    match value {
        -5..-20 => {}
    }

    match value {
        -1.2 => {}
        else => {}
    }

    match value {
        -true => {}
        else => {}
    }
}


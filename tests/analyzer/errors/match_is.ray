fn main() {
    a: int|float = 8.3
    match a is {
        int => 1
        bool => 2
    }

    match a is {
        int => 1
        float => 2
        int => 2
    }

    nonUnion := true
    match nonUnion is {
        
    }

    b := match a is {
        int => 5
        float => _ = "float"
    }

    c: bool = match a is {
        int => 5
        float => true
    }

    d: bool|str = match a is {
        int => 5
        float => true
    }

    match a is {
        int => _ = "int"
        float => _ = "float"
        else => _ = "else"
    }

    // Valide match to check if variable's type isn't changed
    match a is {
        int => _ = "int"
        float => _ = "float"
    }
    // Should still be an union
    _ = a + 1
}

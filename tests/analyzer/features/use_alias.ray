use data.math as m

fn main() {
    // No args
    m.introduce()
    // Args + assignment
    vec := m.getVecFromPos(1, 2)

    // Bounded
    please := m.introduce
    please()

    // Bounded with args producing a type defined in math
    please2 := m.getVecFromPos
    vec2 := please2(6, 89)

    // Accessing fields of type defined in math
    vec2.y
}

struct Bar {
    a: int,
    b: str,
}
enum Foo { a, b }
struct Baz { bar: Bar }

fn main() {
    1+1*2
    1+3/4

    true and false
    true or false

    1 > 2
    1 < 2
    1 >= 2
    1 <= 2
    1 == 3
    1 != 3

    1 & 1
    1 | 1
    1 ^ 1

    --2
    ~0x4

    [1, 2, 3]

    Foo.b
    Bar{ a: 4+5, b: "Tom" }

    [Bar{ a: 4+6, b: "Martin" }, Bar{ a: 7+5, b: "Manon" }]
    Baz{ bar: .{ a: 11, b: "yep" }}
}

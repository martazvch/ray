struct Foo {
    arr: [][]int,
}

fn getIdx() -> int {
    return 2
}

fn main() {
    arr: [][]int = [[1, 2, 3,], [4, 5, 6]]
    arr2 := [[1, 2, 33,], [3, 4, 55,]]
    foo := Foo{ arr=[[6, 7, getIdx()], [8, 9+1, 11]] }

    // Access
    arr[1][2]
    arr[-2][-1]

    // Element assignment
    arr[-1][getIdx()] = 99

    // Element assignment in struct
    foo.arr[getIdx()] = [1]
    foo.arr[getIdx()][1] = -9
    // Access in struct
    foo.arr[getIdx()]
    foo.arr[getIdx()][1]
}

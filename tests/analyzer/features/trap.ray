error ValueErr {
    tooSmall,
    tooBig,
}

fn failable(val: int) -> bool!ValueErr {
    if val < 10 {
        return true
    } else if val > 20 {
        fail .tooBig
    }

    fail .tooSmall
}

fn main() {
    _ = failable(15) trap e {
        e
        break 88
    }
    _ = failable(15) trap match e {
        .tooSmall => 1
        else => 4
    }
    failable(25) trap match e {
        .tooSmall => _ = 1
        else => _ = 4
    }
    _ = failable(15) trap e {
        return
    }
}


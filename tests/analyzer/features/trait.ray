trait Foo {
    fn speak() {
        "hello"
    }
    fn speakNoBody()

    fn withDefault(a: int) -> bool {
        return a == 1
    }
    fn withDefaultNoBody(a: int) -> bool

    fn method0(self) { "method0" }

    fn method1(self) {
        self.method0()
    }
}

struct Bar {
    impl Foo {
        fn speakNoBody() { "bye" }
        fn withDefault(a=9) -> bool {
            return a == 9
        }
        fn withDefaultNoBody(a=2) -> bool { return a == 2 }
    }
}

struct Baz {
    impl Foo {
        fn speakNoBody() { "bye" }
        fn withDefaultNoBody(a=5) -> bool { return a == 5 }
    }
}

fn main() {
    Bar.speak()
    Baz.speak()
    Bar.speakNoBody()
    Baz.speakNoBody()

    Bar.withDefault()
    Baz.withDefault(4)
    Bar.withDefaultNoBody()
    Baz.withDefaultNoBody(5)

    bar := Bar{}
    bar.method1()
}

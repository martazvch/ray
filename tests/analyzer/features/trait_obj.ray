trait Foo {
    fn speak(self, a: int)
}

struct Bar {
    impl Foo {
        fn speak(self, a: int) {
            "Bar " + str(a)
        }
    }
}

struct Baz {
    impl Foo {
        fn speak(self, a: int) {
            "Baz " + str(a)
        }
    }
}

fn f(value: Foo) {
    value.speak(2)
}

fn main() {
    bar := Bar{}
    f(bar)
    baz := Baz{}
    f(baz)
}


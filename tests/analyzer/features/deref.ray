struct Bar {
    a: bool,
    b: str,
}

struct Foo {
    b: *int,
    c: *Bar,
    d: **int,
    e: **Bar,
}

fn main() {
    a := "sss"

    b := *a
    b.*
 
    c := *b
    c.*.*

    value := 9
    bar := Bar{ a=true, b="ok" }
    pvalue := *value
    pbar := *bar

    foo := Foo{ b=*value, c=*bar, d=*pvalue, e=*pbar }
    foo.b.* == value
    foo.c.*.a == bar.a
    foo.d.*.* == value
    foo.e.*.*.b == bar.b
}


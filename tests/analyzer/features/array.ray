struct Foo {
    arr: []int,
}

fn getIdx() -> int {
    return 2
}

fn main() {
    arr: []int = [1, 2, 3,]
    arr2 := [1, 2,]
    foo := Foo{arr=[6, 7, getIdx()]}

    // Access
    arr[1]
    arr[-2]

    // Element assignment
    arr[getIdx()] = 99

    // Element assignment in struct
    foo.arr[getIdx()] = -9
    // Access in struct
    foo.arr[getIdx()]


    // Infer value type
    emptyArr: []int = []

    lateEmptyArr: []int
    lateEmptyArr = []

    ff := Foo{arr=[]}

    arrOpt: []?int = [1, 2]
    arrOpt[1] = 2
    arrOpt[1] = null

    arrOpt = [1, null]

    struct Data { x: int }
    dataArr: []Data = [
        .{ x=1 },
        .{ x=2 },
    ]
}

fn main() {
    for a in [1, 2, 3] {
        a
    }

    arr := [5, 6, 7, 8]
    for a in arr {
        a
    }

    string := "Tom"
    for c in string {
        c
    }

    for c in "Martin" {
        c
    }

    for v, i in [] {
        i
    }

    for v in 0..5 {
        v
    }

    for i in -1..5 {
        i
    }

    for i in -8..-5 {
        i
    }

    loop: for c in "Martin" {
        break :loop
    }

    b: {
        a := 1
        loop: for c in "Martin" {
            break :b
        }
    }
}


struct Point {
    x, y: int,
    past: [][]int,
}

struct Poly {
    vertex: [][]Point
}

struct Object {
    poly: Poly,
    name: str = "object",
}

fn main() {
    p1 := Point{ x=1, y=2, past=[[1, 2], [3, 4]]}
    p2 := Point{ x=5, y=6, past=[[7, 8], [9, 10]]}
    p3 := Point{ x=11, y=12, past=[[13, 14], [15, 16]]}
    p4 := Point{ x=17, y=18, past=[[19, 20], [21, 22]]}

    poly := Poly{ vertex=[[p1, p2], [p3, p4]] }
    obj := Object{ poly } 

    obj.poly.vertex[1][0]
    obj.poly.vertex[1][0].x
    obj.poly.vertex[1][0].past[0]
    obj.poly.vertex[1][0].past[1][1]

    obj.poly.vertex[1][0].past[0] = [55, 66]
}

enum Marker {
    cross,
    circle,
    none

    fn toString(self) -> str {
        if self == Self.cross do return "x"
        if self == Self.circle do return "o"
        return "x"
    }
}

struct Cell {
    marker = Marker.cross,
    marker2: Marker = .circle
}

fn markerStuff(m: Marker = Marker.cross) {
    m.toString()
}

fn markerStuff2(m = Marker.circle) {
    m.toString()
}

fn getMarker() -> Marker {
    return .circle
}

fn main() {
    marker: Marker = .none
    marker = .circle

    markerStuff(.circle)
    markerStuff2(.cross)

    cell := Cell{}
    cell.marker = .circle

    cell.marker == .circle
    cell.marker != .circle

    marker == .none
    marker == Marker.none
    Marker.none == Marker.none
}


fn main() {
    // Near scope capture
    a: int = 3

    fn capture() { print(a) }

    // Far scope capture
    first := 1
    c: int = 3
    b := true
    last := 9

    fn nested() {
        mach: int
        mach2 := c

        fn nested2() {
            mach3: int

            fn capture1() { print(b) }
        }
    }

    // Assignment
    d := 1

    fn capture2() { print(d) }

    d = 2
}

fn main() {
    {
        use data.math
        // No args
        math.introduce()
        // Args + assignment
        vec := math.getVecFromPos(1, 2)

        // Bounded
        please := math.introduce
        please()

        // Bounded with args producing a type defined in math
        please2 := math.getVecFromPos
        vec2 := please2(6, 89)

        // Accessing fields of type defined in math
        vec2.y
    }
}

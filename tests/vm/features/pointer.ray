struct Foo {
    a: int,
    b: str,
}

fn f(a: *int) {
    print(a.*)
}

fn main() {
    a := 1
    b := *a
    c := *a
    print(*a == b)
    print(b == c)
    print(*a != b)
    print(b != *a)

    foo := Foo{ a=2, b="ok" }
    ref1 := *foo.a
    ref2 := *foo.b
    print(*foo.a == *foo.a)
    print(ref1 == *foo.a)
    print(ref2 == ref2)

    f(*a)
    a = 6
    f(*a)

    arr := [1, 2, 3]
    ptr := *arr[1]
    print(ptr.*)
    print(arr)

    ptr.* = 99
    print(ptr.*)
    print(arr)
}


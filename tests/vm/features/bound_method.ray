struct Person {
    age: int,

    fn speak(self) {
        self.age = self.age * 10
        print(self.age)
    }

    fn getOld(self, amount: int) -> int {
        self.age = self.age + amount
        return self.age
    }
}

fn oui() {
    print("oui")
}

fn main() {
    p := Person{age=5}

    // Mess up with stack
    a := 5

    method1: fn() -> void 
    method1 = p.speak
    method2: fn() -> void = p.speak
    method3 := p.speak

    method1()
    oui()

    p.speak()
    method2()
    _ = p.getOld(8)
    method3()
}


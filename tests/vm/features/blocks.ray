glob1 := 7.5
glob2 := 42.5

fn main() {
    // Last expression returned while discarding inbetween locals
    a: int = val: {
        space := 67
        nb := 7
        sneaky := 90
        break :val nb
    }

    print(a) // expect: 7

    // Returning an outter local from a scope
    b := 56

    c: int = val: {
        sneaky := 90
        break :val b
    }

    print(c) // expect: 56

    {
        tmp := 67
        b := 87. - 6.
        print(b) // expect: 81
    }

    // Naked break
    b: {
        break :b
        print("no") // should not see this one
    }

    // Returning a global
    scope := val: {
        print("in scope") // expect: "in scope"
        break :val glob1
    }

    print(scope) // expect: 7.5

    // Breaks only inner scope
    {
        b: {
            a := 1
            break :b
            print("ayo")
        }
        print("oh boi")
    }
}

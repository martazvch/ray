fn factory() -> fn() -> void {
    a := 1
    
    fn capture() { print(a) }

    return capture
}

fn factory2() -> fn() -> void {
    a := 1
    
    fn capture() {
        a = a + 1
        print(a)
    }

    return capture
}

fn factory3() -> fn() -> int {
    a := 90
    
    fn capture() -> int {
        a = a * 10
        return a
    }

    return capture
}

fn factory4(arg: int) -> fn(int, bool) -> float {
    a := arg

    fn capture(value: int, cond: bool) -> float {
        if cond and value > a do return 56.
        if not cond and value < a do return 80.

        return 123.
    }

    return capture
}

fn main() {
    prod1 := factory()
    prod1() // expect: 1

    prod2 := factory2()
    prod2() // expect: 2
    prod2() // expect: 3
    prod2() // expect: 4

    prod3 := factory3()
    print(prod3()) // expect: 900
    print(prod3()) // expect: 9000

    prod4 := factory4(25)
    print(prod4(50, true)) // expect: 56
    print(prod4(4, false)) // expect: 80
    print(prod4(50, false)) // expect: 123

    prod4_bis := factory4(150)
    print(prod4_bis(50, true)) // expect: 123
    print(prod4_bis(4, false)) // expect: 80
    print(prod4_bis(50, false)) // expect: 80
}

struct Pet {
    name: str,
    life: float

    fn speakTo(self, to: str) {
        print(self.name + to)
    }
}

struct Human {
    age: int,
    name: str,
    pet: Pet

    fn getOld(self, amount: int) -> int {
        self.age = self.age + amount
        return self.age
    }

    fn speak(self) {
        print("I'm " + self.name)
        print("My pet is " + self.pet.name)
    }
}

fn main() {
    pet := Pet{name="Vodka", life=9.5}
    tom := Human{age=5, name="Tom", pet}
    trash: int

    tom.speak() 
    print(tom.getOld(60))
    trash2: int
    tom.pet.speakTo(tom.name)
}


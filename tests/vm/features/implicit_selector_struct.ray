struct Vec2 {
    x, y: int,
}

struct Line {
    a, b: Vec2,
}

struct Foo {
    a: int,
    c: str,
}

fn printFoo(foo: Foo) {
    print foo.a
    print foo.c
}

fn main() {
    var foo: Foo = .{a: 1, c: "yes"}
    printFoo(foo)
    foo = .{a: 2, c: "no"}
    printFoo(foo)

    printFoo(.{ a: 3, c: "Tom" })
    printFoo(foo: .{ a: 4, c: "Manon" })
    
    let line: Line = .{
        a: .{ x: 1, y: 2 },
        b: .{ x: 3, y: 4 },
    }
    print line.a.x
    print line.a.y
    print line.b.x
    print line.b.y
}

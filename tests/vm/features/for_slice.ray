fn printTest(id: int, arr: []int, slice: [&]int) {
    print("---- Test {id} ----")
    print(arr)
    print(slice)
    print("")
}

fn main() {
    arr := [1, 2, 3]
    slice := *arr[0..2]
    printTest(1, arr, slice)

    slice[1] = 999
    printTest(2, arr, slice)

    for v in slice {
        print(v)
        v = 1234
    }
    printTest(3, arr, slice)

    for *v in slice {
        v.* = 56
    }
    printTest(4, arr, slice)

    for v in arr[0..1] {
        print(v)
        v = 7
    }
    printTest(5, arr, slice)

    for *v in *arr[0..1] {
        print(v.*)
        v.* = 7
    }
    printTest(6, arr, slice)

    for v in slice[0..2] {
        print(v)
        v *= 10
    }
    printTest(7, arr, slice)

    for *v in slice[0..2] {
        print(v.*)
        v.* *= 20
    }
    printTest(8, arr, slice)
}

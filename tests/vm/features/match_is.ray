fn getValue() -> int|float {
    return 5
}

fn main() {
    a: int|float = 8.3

    match a is {
        int => print(a + 1)
        float => print("float")
    }

    b := match a is {
        int => 1
        else => 5
    }
    print(b)

    trash := true
    match getValue() @v is {
        float => print(v + 8.5)
        int => print(1 + v)
    }
}


struct Data {
    a, b: int,
}

enum Dir {up, down}

fn useData(data: ?Data, dir: ?Dir) {
    if d := data {
        print(d.a)
        print(d.b)
    }
    if d := dir {
        print(d)
    }
}

fn main() {
    useData(.{ a=1, b=2 }, .down)
    useData(null, null)

    data :?Data = .{ a=3, b=4 }
    if d := data {
        print(d.a)
        print(d.b)
    }
}

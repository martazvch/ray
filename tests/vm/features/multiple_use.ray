use data.math
use data.geom

fn main() {
    middle := geom.Point{ x=1, y=90 }
    middle.display()
    
    square := geom.Square{ side=10, middle }
    print(square.middle.x)
    print(square.middle.y)

    math.introduce()
    vec := math.getVecFromPos(square.middle.x, square.middle.y)
    print(vec.x)
    print(vec.y)

    {
        use data.sub.simple_str
        print(simple_str.quote("local import"))
        middle.display()
        print(simple_str.concat("just ", "concaneted"))
    }

    new_middle := square.moveCenter(middle)
    new_middle.display()
    print(square.middle.x)
    print(square.middle.y)
}


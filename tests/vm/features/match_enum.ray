enum Marker {
    cross,
    circle,
    none
}

enum Bar{a}

fn main() {
    marker: Marker = .cross
    bar: Bar = .a

    match marker {
        Marker.circle => print("circle")
        Marker.cross => print("cross")
        Marker.none => print("none")
    }

    marker = .circle
    match marker {
        .circle => print("circle")
        .cross => print("cross")
        .none => print("none")
    }

    marker = .none
    foo := match marker {
        .circle => 1
        .cross => 2
        .none => {
            tmp := 4
            tmp2 := 6
            break 3
        }
    }

    print(foo)

    a := match marker {
        .circle => "circle"
        else => "any other"
    }
    print(a)

     print(match marker {
        else => "all cases"
    })
}


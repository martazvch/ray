fn main() {
    // No braces
    z := if true do 1 else 2
    print(z) // expect: 1

    y := if false do return else 3
    print(y) // expect: 3

    x := if true do 23 else return
    print(x) // expect: 23

    // With blocks
    a := b: if true { break :b 5 } else 12
    print(a) // expect: 5

    b := b: if false do 5 else { break :b 8 }
    print(b) // expect: 8

    c := b: if false { break :b 5 } else { break :b 21 }
    print(c) // expect: 21

    d := if cond: { break :cond true } do 5 + 6 else 1
    print(d) // expect: 11

    e := val: if not true do b: { break :b 5 + 6 } else {
        tmp := 1
        print(tmp) // expect: 1
        tmp = 5
        print(tmp) // expect: 5
        break :val a + b + tmp
    }
    print(e) // expect: 18

    g := if not not true do 6/2 else 0
    print(g) // expect: 3

    h := b: if if true do true else false {
        tmp := 3
        break :b tmp + e
    } else -8

    print(h) // expect: 21

    // Labelled
    cond: if true {
        if 1 == 1 do break :cond
        print("unreachable")
    }
}

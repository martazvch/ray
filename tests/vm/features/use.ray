use data.math

fn main() {
    math.introduce()
    vec := math.getVecFromPos(1, 2)
    print(vec.x)
    print(vec.y)
    vec = math.getVecFromPos(8, 9)
    print(vec.x)
    print(vec.y)

    fn trash(a: int) -> bool {
        return a < 10
    }
    print(trash(vec.y))

    vec = math.getVecFromPos(3, 7)
    print(vec.x)
    print(vec.y)

    please := math.introduce
    please()

    please2 := math.getVecFromPos
    vec2 := please2(6, 89)

    print(vec2.x)
    print(vec2.y)
}

fn main() {
    // Near scope capture
    a: int = 3
    fn capture() { a += 5 }

    // Far scope capture
    first := 1
    c: int = 3
    b := true
    last := 9

    capture()
    print(a)

    fn nested() {
        mach: int

        fn nested2() {
            mach3: int
            fn capture1() {
                print(b)
                print(c)
            }
            b = false
            capture1()
        }

        // Capture another one
        mach2 := c
        nested2()
    }

    // Assignment
    d := 1
    fn capture2() { print(d) }
    d = 2
    capture2()

    nested()
}

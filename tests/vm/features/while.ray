// global
i := 0

fn main() {
    // expect: 0
    // expect: 1
    // expect: 2
    // expect: 3
    while i<4 {
        print(i)
        i = i + 1
    }
    print("----")

    // local with condition manipulation
    {
        i := 3
        // expect: 3
        // expect: 5
        // expect: 7
        // expect: 9
        while i > 2 {
            print(i)

            i = i + 2
            if i > 10 do i = 1
        }
    }
    print("----")

    // local with stack manipulation
    offset := 3
    {
        i := 5
        j := 8

        // expect: 8
        // expect: 11
        while i < 9 {
            tmp := 12/3
            j = i + offset
            print(j)
            i = i + offset
        }
    }
    print("----")
}

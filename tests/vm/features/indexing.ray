fn main() {
    arr1 := [1, 2, 3]
    print(arr1[1])
    print(arr1[-1])
    print(arr1[0..1])

    arr2 := [[1, 2, 3], [4, 5, 6]]
    print(arr2[1])
    print(arr2[1][2])
    print(arr2[0..1])
    print(arr2[0][1..3])

    name := "Tom"
    print(name[1])
    print(name[1..2])
    print(name[1..3])
}


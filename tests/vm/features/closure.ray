globalSet: fn() -> void
globalGet: fn() -> void

fn set_vars() {
    a := "init"

    // Here, assignment refers to heap variable
    fn set() { a = "updated" }
    fn get() { print(a) }

    globalSet = set
    globalGet = get
}

fn outer() -> fn() -> void {
    x := "outside"

    fn inner() {
        print(x)
    }

    return inner
}

fn main() {
    closure := outer()
    closure()

    set_vars()

    globalSet()
    globalGet()
}

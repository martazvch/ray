struct Vec2 {
    x, y: int,

    fn +(self, other: Self) -> Self {
        return .{
            x: self.x + other.x,
            y: self.y + other.y,
        }
    }

    fn -(self, other: Self) -> Self {
        return .{
            x: self.x - other.x,
            y: self.y - other.y,
        }
    }

    fn -(self) -> Self {
        return .{
            x: -self.x,
            y: -self.y,
        }
    }


    fn *(self, other: Self) -> Self {
        return .{
            x: self.x * other.x,
            y: self.y * other.y,
        }
    }

    fn /(self, other: Self) -> Self {
        return .{
            x: self.x / other.x,
            y: self.y / other.y,
        }
    }

    fn display(self) {
        print "x: " + str(self.x) + ", y: " + str(self.y)
    }
}

fn main() {
    let v1 = Vec2{ x: 4, y: 12 }
    let v2 = Vec2{ x: 2, y: 4 }

    let add = v1 + v2
    add.display()

    let sub = v1 - v2
    sub.display()

    let mul = v1 * v2
    mul.display()

    let div = v1 / v2
    div.display()

    let neg = -v1
    neg.display()
}

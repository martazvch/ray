fn matchIntValue(value: int) {
    print(match value {
        -5 => -20
        -8..-2 => -10
        0 => 10
        2 => 30
        3 => 30
        1..8 => 90
        else => 100
    })
}

fn main() {
    matchIntValue(-5) // -20
    matchIntValue(-6) // -10
    matchIntValue(2)  // 30
    matchIntValue(7)  // 90
    matchIntValue(25) // 100
}


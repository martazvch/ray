use data.cmodule.cmodule as c

fn mutateWorld(w: c.World) {
    w.age = 111
}

fn main() {
    w := c.World{
        age = 1,
        pos = .{ x = 4.5, y = 6.8 },
        count = -1,
    }
    print(w)

    c.printWorld(w)
    w.age += 64
    w.pos.x = 5.2
    w.pos.y += 3.2
    w.count = 99
    c.printWorld(w)

    mutateWorld(w)
    c.printWorld(w)
}

fn main() {
    value := true
    match value {
        true => print(true)
        false => print(false)
    }

    value = false
    match value {
        true => print(true)
        false => print(false)
    }

    value = false
    match value {
        true => print(true)
        else => print(false)
    }

    value = true
    match value {
        true => print(true)
        else => print(false)
    }
}


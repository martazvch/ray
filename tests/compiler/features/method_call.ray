struct Human {
    age: int,
    name: str,

    fn speak(self) {
        _ = self.name
    }

    fn getOld(self, amount: int) -> int {
        self.age = self.age + amount
        return self.age
    }
}

fn main() {
    human := Human{ age=5, name="Tom" }
    trash: int
    human.speak()
    _ = human.getOld(10)
}


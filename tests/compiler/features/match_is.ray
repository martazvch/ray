fn main() {
    a: int|float = 8.3

    match a is {
        int => _ = a + 1
        float => _ = "float"
    }

    b := match a is {
        int => 1
        else => 5
    }

    trash := true
    match a is {
        float {
            1.2 => _ = "first"
            4.5..10.0 => _ = "second"
            else => _ = "non"
        }
        int => _ = "int"
    }
}

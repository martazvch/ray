// Note:
//  - each jump count as 3 OP (the jump + 2x8bits jump value)
//  - OP count begins at 0
//  - we jump just after the other JUMP (on the POP) to exit the then branch

fn main() {
    if true do print("yes")

    if true  { _ =  "yes" }

    if false { _ =  "yes" } else { _ =  "no" }

    a := b: if true { break :b 1 } else { break :b 2 }

    b := if cond: { break :cond true } do 5 + 6 else 1

    c := if not true do 5 + 6 else val: {
        tmp := 1
        _ =  tmp
        tmp = 5
        break :val a + b + tmp
    }
}


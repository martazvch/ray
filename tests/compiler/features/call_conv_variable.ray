// All assignment should resolve to the same type and calling convention
// should be transmitted

use data.math 

struct Foo {
    value := 8

    fn static() -> int { return 3 }

    fn method(self) -> int {
        return self.value
    }

    fn importFuncFromMethod(self) -> fn() -> int {
        return math.getInt
    }
}

fn copy() -> int {
    return 5
}

fn main() {
    foo := Foo{}

    bound := Foo.static
    bound()

    bound = copy
    bound()

    bound = foo.method
    bound()

    bound = math.getInt
    bound()

    // Call conv survives a layer
    tmp := foo.importFuncFromMethod
    tmp()
    bound = tmp()
    bound()
                    
    // Builtins
    bind := int
    bind(5.6)
}

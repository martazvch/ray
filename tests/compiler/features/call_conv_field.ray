// All assignment should resolve to the same type and calling convention
// should be transmitted
use data.math 

struct Foo {
    function: fn() -> int
}

struct Bar {
    value := 0

    fn static() -> int { return 3 }

    fn method(self) -> int {
        return self.value
    }
}

fn copy() -> int {
    return 5
}

fn main() {
    bar := Bar{}

    foo := Foo{function=copy}
    foo.function()

    foo.function = Bar.static
    foo.function()

    foo.function = bar.method
    foo.function()

    foo.function = math.getInt
    foo.function()
}


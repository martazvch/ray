-- speak --
load_const index 0, value I'm Bar
pop
ret_naked

-- other --
get_local index 0
call index 0, arity 1, speak
ret_naked

-- speak --
load_const index 1, value I'm Baz
pop
ret_naked

-- other --
get_local index 0
call index 2, arity 1, speak
ret_naked

-- main --
load_const index 2, value Bar{}
get_local index 0
call index 0, arity 1, speak
get_local index 0
call index 1, arity 1, other

load_const index 3, value Baz{}
get_local index 1
call index 2, arity 1, speak
get_local index 1
call index 3, arity 1, other

ret_naked

-- global scope --
call index 4, arity 0, main


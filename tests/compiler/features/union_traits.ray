trait Foo {
    fn speak() { _ = "oui" }
    fn speakNoDef()

    fn method(self) { _ = "method" }
    fn methodNoDef(self)
}

union Bar {
    a: int,
    b: str,
    
    impl Foo {
        fn speakNoDef() { _ = "noDef" }
        fn methodNoDef(self) {
            if self == .a {
                _ = "I'm a: " + str(self.a)
            } else {
                _ = "I'm b: " + self.b
            }
        }
    }
}

fn main() {
    Bar.speak()
    Bar.speakNoDef()

    bar: Bar = .a(1)
    bar.method()
    bar.methodNoDef()
}


struct Human {
    age: int,
    name: str,

    fn speak(self) {
        print(self.name)
    }

    fn getOld(self, amount: int) -> int {
        self.age = self.age + amount
        return self.age
    }
}

fn main() {
    human := Human{ age=5, name="Tom" }
    trash: int
    speak := human.speak
    trash2: int
    getOld := human.getOld

    speak()
    _ = getOld(10)
}


fn main() {
    value := 2

    _ = match value {
        0 => 10
        2 => 30
        3 => 30
        1..8 => 90
        else => 100
    }

    fvalue := 2.0

    _ = match fvalue {
        -1.2 => -10
        0.1 => 10
        1.3..8.1 => 90
        -10.3..-8.1 => 90
        else => 100
    }
}


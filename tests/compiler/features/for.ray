fn main() {
    for a in [1, 2, 3] {
        _ =  a
    }

    arr := [5, 6, 7, 8]
    for a in arr {
        _ =  a
    }

    string := "Tom"
    for c in string {
        _ =  c
    }

    for c in "Martin" {
        _ =  c
    }

    for i, v in [true, false] {
        _ =  i
        _ =  v
    }

    for v in 0..5 {
        _ =  v
    }
    
    for i in -1..5 {
        _ =  i
    }

    for i in -8..-5 {
        a := i
    }
}

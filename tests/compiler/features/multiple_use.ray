use data.math
use data.geom

fn main() {
    middle := geom.Point { x=1, y=90 }
    middle.display()
    
    square := geom.Square { side=10, middle }
    _ = square.middle.x
    _ = square.middle.y

    math.introduce()
    vec := math.getVecFromPos(square.middle.x, square.middle.y)
    _ = vec.x
    _ = vec.y

    {
        use data.sub.simple_str
        _ = simple_str.quote("local import")
        middle.display()
        _ = simple_str.concat("just ", "concaneted")
    }

    new_middle := square.moveCenter(middle)
    new_middle.display()
    _ = square.middle.x
    _ = square.middle.y
}


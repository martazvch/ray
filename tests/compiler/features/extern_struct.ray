extern struct Vec2 {
    x, y: float,
}

extern struct Foo {
    a: int,
    b: float,
    pos: Vec2,
}

fn main() {
    foo := Foo{ 
        a = 1,
        b = 4.5, 
        pos = .{ x = 11, y = 22 }
    }
    foo.a = 2
    foo.b

    v := foo.pos
    print(v)
    v.y = 999
    print(v)
    print(foo.pos)
}

enum Foo { a, b }
enum Bar {
    a,
    b,

    fn init() -> Self {
        return Self.a
    }

    fn toStr(self) -> str {
        if self == Self.a do return "a"
        return "b"
    }
}

fn main() {
    foo := Foo.a
    bar := Bar.b

    foo == Foo.a
    Foo.a == foo
    Foo.a == Foo.b

    bar != Bar.a
    Bar.a != bar
    Bar.a != Bar.b

    d := Bar.init()
    _ = d.toStr()
}



struct Foo {
    arr: []int,
}

fn getIdx() -> int {
    return 2
}

fn main() {
    arr: []int = [1, 2, 3,]
    arr2 := [1, 2,]
    foo := Foo{arr=[6, 7, getIdx()]}

    // Access
    arr[1]
    arr[-2]

    // Element assignment
    arr[getIdx()] = 99

    // Element assignment in struct
    foo.arr[getIdx()] = -9
    // Access in struct
    foo.arr[getIdx()]

    // Array index must not be cow-checked
    i, j := 1
    arr3 := [[1, 2], [3, 4]]
    arr3[i][j] = 98
}

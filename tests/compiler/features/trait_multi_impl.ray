trait Foo {
    fn speak(self)
    fn other(self) {
        self.speak()
    }
}

struct Bar {
    impl Foo {
        fn speak(self) {
            _ = "I'm Bar"
        }
    }
}
struct Baz {
    impl Foo {
        fn speak(self) {
            _ = "I'm Baz"
        }
    }
}

fn main() {
    bar := Bar{}
    bar.speak()
    bar.other()

    baz := Baz{}
    baz.speak()
    baz.other()
}


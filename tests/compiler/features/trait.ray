trait Foo {
    fn speak() {
        _ = "hello"
    }
    fn speakNoBody()

    fn withDefault(a: int) -> bool {
        return a == 1
    }
    fn withDefaultNoBody(a: int) -> bool

    fn method0(self) { _ = "method0" }

    fn method1(self) {
        self.method0()
    }
}

struct Bar {
    impl Foo {
        fn speakNoBody() { _ = "bye" }
        fn withDefault(a=9) -> bool {
            return a == 9
        }
        fn withDefaultNoBody(a=2) -> bool { return a == 2 }
    }
}

struct Baz {
    impl Foo {
        fn speakNoBody() { _ = "bye" }
        fn withDefaultNoBody(a=5) -> bool { return a == 5 }
    }
}

fn main() {
    Bar.speak()
    Baz.speak()
    Bar.speakNoBody()
    Baz.speakNoBody()

    _ = Bar.withDefault()
    _ = Baz.withDefault(4)
    _ = Bar.withDefaultNoBody()
    _ = Baz.withDefaultNoBody(5)

    bar := Bar{}
    bar.method1()
}


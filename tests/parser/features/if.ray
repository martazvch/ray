if true { "ok" }
if true {
    "ok"
}

if true
{
    "ok"
}
else "ko"

if true {
    "ok" } else {
    "ko" }


// Condition as block

if {
    "in cond"
    false
}{
    "ok"
}


// Do syntax

if true do "ok"

if true do "ok"
else "ko"

if true do "ok"
else { "ko" }


// Else if

if true do "ok"
else if true do "elseif"
else "ko"


// If as expression

_res := if true do 5 else 10

// Labelled
cond: if true do "ok"

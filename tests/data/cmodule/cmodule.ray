extern "cmodule" fn ret_no_arg() -> float
extern "cmodule" fn ret_arg(a: float) -> float

extern "cmodule" {
    fn ret_args(a, b: float) -> float
    fn void_no_arg()
    fn void_arg(a: float)
    fn void_args(a, b: float)
}

// Nested structures
extern struct Vec2 {
    x, y: float,
}

extern struct World {
    age: int,
    pos: Vec2,
    count: int,
}

extern "cmodule" fn printWorld(w: World)


// Regular ray function
fn rayFunc(a: float) -> float {
    return ret_arg(2. * a)
}
